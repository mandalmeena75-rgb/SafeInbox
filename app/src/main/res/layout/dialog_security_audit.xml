<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#1B1228">

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_fingerprint"
                android:contentDescription="Security Audit Icon"
                app:tint="@color/premium_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Security Audit"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/premium_gold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Sender Info -->
        <TextView
            android:id="@+id/audit_sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:text="Name (Number)" />

        <TextView
            android:id="@+id/audit_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/primary_light_purple"
            android:layout_marginTop="4dp"
            android:text="Date" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Message Body Container -->
        <TextView
            android:id="@+id/audit_body_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_white"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Audit Breakdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VERDICT BREAKDOWN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_hint"
            android:letterSpacing="0.15"
            android:layout_marginBottom="16dp" />

        <!-- ML Score Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Classifier Confidence"
                    android:textSize="14sp"
                    android:textColor="#E1BEE7" />
                <TextView
                    android:id="@+id/audit_ml_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/frost_blue_soft"
                    android:text="0%" />
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/audit_ml_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:progressTint="@color/frost_blue_soft" />
        </LinearLayout>

        <!-- Keyword Strength Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suspicious Keywords"
                    android:textSize="14sp"
                    android:textColor="#E1BEE7" />
                <TextView
                    android:id="@+id/audit_keyword_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/premium_gold"
                    android:text="Low" />
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/audit_keyword_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progressTint="@color/premium_gold" />
        </LinearLayout>

        <!-- Sender History Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sender Reputation"
                    android:textSize="14sp"
                    android:textColor="#E1BEE7" />
                <TextView
                    android:id="@+id/audit_history_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_light_purple"
                    android:text="Neutral" />
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/audit_history_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progressTint="@color/primary_light_purple" />
        </LinearLayout>

        <!-- Final Verdict -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2A1B38"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="24dp">
            
            <TextView
                android:id="@+id/audit_final_verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/error_red"
                android:text="VERDICT: Analyzing..."
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <!-- Custom Action Buttons -->
        <LinearLayout
            android:id="@+id/audit_action_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                
                <Button
                    android:id="@+id/btn_audit_negative"
                    style="@style/SafeInbox.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Not Spam" />
                    
                <Button
                    android:id="@+id/btn_audit_positive"
                    style="@style/SafeInbox.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Mark Spam" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_audit_block"
                style="@style/SafeInbox.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeColor="@color/error_red"
                android:textColor="@color/error_red"
                android:text="🚫 Block Sender" />
                
            <Button
                android:id="@+id/btn_audit_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="@color/text_grey"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:text="Cancel &amp; Close" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
