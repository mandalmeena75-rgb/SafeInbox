<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (Material 3) -->
    <style name="Theme.SafeInbox" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main system colors -->
        <item name="colorPrimary">@color/primary_deep_purple</item>
        <item name="colorSecondary">@color/primary_light_purple</item>
        <item name="colorTertiary">@color/accent_purple</item>
        
        <item name="android:windowBackground">@color/bg_dark_start</item>
        <item name="android:statusBarColor">@color/bg_dark_start</item>
        <item name="android:navigationBarColor">@color/bg_dark_end</item>
        
        <!-- Typography -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Premium Card Style -->
    <style name="SafeInbox.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_bg_transparent</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">8dp</item>
    </style>

    <!-- Premium Button Style (Rounded Pill) -->
    <style name="SafeInbox.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">32dp</item>
        <item name="android:background">@drawable/btn_purple_gradient</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Dark Alert Dialog Theme -->
    <style name="DarkAlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:background">@color/card_bg_dark</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_grey</item>
        <item name="colorPrimary">@color/primary_light_purple</item>
    </style>

</resources>