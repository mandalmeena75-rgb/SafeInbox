<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeInbox">

        <!-- Splash screen (Launcher - Temporarily bypassed) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeInbox">
        </activity>

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafeInbox"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OTPActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafeInbox"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeInbox" />

        <activity
            android:name=".activities.DashboardActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafeInbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.InboxActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeInbox" />

        <activity
            android:name=".activities.SpamActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeInbox" />

        <activity
            android:name=".activities.AnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeInbox" />

        <activity
            android:name=".activities.ArchiveActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafeInbox" />

        <activity
            android:name=".activities.SecurityAdvisorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafeInbox" />

        <!-- Existing SMS Services & Receivers -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".services.SmsNotificationListener"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations,alerting" />
        </service>

    </application>

</manifest>